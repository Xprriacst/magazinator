        "requestFormat": "json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "body": {
          "mimeType": "application/json",
          "content": "={\n  \"prompt\": $input.item.json.prompt || \"Magazine moderne avec InDesign automation\",\n  \"text_content\": $input.item.json.text_content || \"Article de démonstration automatique avec mise en page InDesign\",\n  \"image_urls\": $input.item.json.image_urls || [\"https://picsum.photos/800/600?random=1\", \"https://picsum.photos/600/400?random=2\"]\n}"
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "flask-api-call",
      "name": "Call Flask API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success_condition",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-success",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"status\": \"success\",\n  \"message\": \"Mise en page InDesign créée avec succès!\",\n  \"project_id\": $('Call Flask API').item.json.project_id,\n  \"download_url\": 'https://ca2c78956abc.ngrok-free.app/api/download/' + $('Call Flask API').item.json.project_id,\n  \"output_file\": $('Call Flask API').item.json.output_file,\n  \"timestamp\": $now\n} }}",
        "options": {}
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"status\": \"error\",\n  \"message\": \"Erreur lors de la création de la mise en page\",\n  \"error\": $('Call Flask API').item.json.error || 'Erreur inconnue',\n  \"timestamp\": $now,\n  \"details\": $json\n} }}",
        "options": {}
      },
      "id": "error-response",
      "name": "Error Response",
