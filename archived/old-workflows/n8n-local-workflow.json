{
  "name": "InDesign Automation Local",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "indesign-automation",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-local",
      "name": "Webhook Local",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 300],
      "webhookId": "indesign-automation"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5002/api/create-layout-urls",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer alexandreesttropbeau"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"prompt\": \"{{ $input.item.json.prompt || 'Magazine moderne local' }}\",\n  \"text_content\": \"{{ $input.item.json.text_content || 'Article généré en local par n8n' }}\",\n  \"image_urls\": {{ $input.item.json.image_urls || [\"https://picsum.photos/800/600?random=1\"] }}\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "flask-api-local",
      "name": "Flask API Local",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "success_condition",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-success",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"status\": \"success\",\n  \"message\": \"🎉 Document InDesign créé avec succès!\",\n  \"project_id\": $('Flask API Local').item.json.project_id,\n  \"download_url\": 'http://localhost:5002/api/download/' + $('Flask API Local').item.json.project_id,\n  \"output_file\": $('Flask API Local').item.json.output_file,\n  \"timestamp\": $now,\n  \"workflow\": \"n8n-local-indesign\",\n  \"mode\": \"local development\"\n} }}",
        "options": {}
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {\n  \"status\": \"error\",\n  \"message\": \"❌ Erreur lors de la création\",\n  \"error\": $('Flask API Local').item.json.error || 'Erreur inconnue',\n  \"timestamp\": $now,\n  \"troubleshooting\": \"Vérifiez Flask (localhost:5002) et InDesign\",\n  \"mode\": \"local development\"\n} }}",
        "options": {}
      },
      "id": "error-response",
      "name": "Error Response", 
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, 400]
    }
  ],
  "connections": {
